{
  "name": "@langreport/contracts",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./http": "./src/http.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test:typecheck": "tsc --noEmit -p tsconfig.test.json",
    "build": "tsc --noEmit -p tsconfig.json",
    "test": "tsx --test test/unit/http.test.ts test/unit/model.test.ts",
    "test:coverage": "tsx --test --experimental-test-coverage test/unit/http.test.ts test/unit/model.test.ts"
  },
  "dependencies": {
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@types/node": "26.4.0",
    "tsx": "4.23.13",
    "typescript": "7.0.2"
  }
}
