{
  "name": "@langreport/flint-adapter",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./validation": "./src/validation.ts"
  },
  "scripts": {
    "test": "tsx --test test/unit/index.test.ts",
    "test:coverage": "tsx --test --experimental-test-coverage test/unit/index.test.ts",
    "test:typecheck": "tsc --noEmit -p tsconfig.test.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "build": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@langreport/contracts": "workspace:*",
    "flint-chart": "0.5.1",
    "sharp": "0.35.4"
  },
  "devDependencies": {
    "@types/node": "26.4.0",
    "tsx": "4.23.13",
    "typescript": "7.0.2"
  }
}
