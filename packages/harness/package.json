{
  "name": "@langreport/harness",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "test": "tsx --test test/unit/structured-model.test.ts",
    "test:coverage": "tsx --test --experimental-test-coverage test/unit/structured-model.test.ts",
    "test:typecheck": "tsc --noEmit -p tsconfig.test.json",
    "check:dependencies": "tsx --test --test-name-pattern=\"does not depend on LangReport application packages\" test/unit/structured-model.test.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "build": "tsc --noEmit -p tsconfig.json"
  },
  "devDependencies": {
    "@types/node": "26.4.0",
    "tsx": "4.23.13",
    "typescript": "7.0.2"
  }
}
