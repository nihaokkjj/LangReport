# Copy to .env.production on the ECS host and replace every placeholder.
# Do not commit .env.production.

NODE_ENV=production

POSTGRES_USER=langreport
POSTGRES_PASSWORD=replace-with-a-long-random-password
POSTGRES_DB=langreport

S3_ACCESS_KEY=langreport
S3_SECRET_KEY=replace-with-another-long-random-password
S3_BUCKET=langreport

# The exact public Vercel origin, for example https://langreport.vercel.app
WEB_ORIGIN=https://your-project.vercel.app
API_PORT=4000

# The external login gateway signs HS256 tokens with this secret and sends
# them as Authorization: Bearer or the langreport_session cookie.
AUTH_JWT_SECRET=replace-with-at-least-32-random-characters
AUTH_SESSION_COOKIE=langreport_session
# Optional claim checks for the external auth gateway.
AUTH_JWT_ISSUER=
AUTH_JWT_AUDIENCE=

# Optional polling intervals for the PostgreSQL-backed workers.
GENERATION_POLL_INTERVAL_MS=1000
RENDER_POLL_INTERVAL_MS=1000
