DATABASE_URL=postgres://langreport:langreport@localhost:54329/langreport

S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=langreport
S3_SECRET_KEY=langreport-dev-secret
S3_BUCKET=langreport

API_URL=http://localhost:4000
API_PROXY_ORIGIN=http://localhost:4000
NEXT_PUBLIC_API_URL=/api
WEB_ORIGIN=http://localhost:3000
GENERATION_STATUS_LONG_POLL=true

# Local development also requires the login gateway. Generate the password hash
# with `pnpm auth:hash-password`, then uncomment and fill all four values in .env.
# AUTH_JWT_SECRET=replace-with-at-least-32-random-characters
# AUTH_LOGIN_USERNAME=operator
# AUTH_LOGIN_USER_ID=operator
# AUTH_LOGIN_PASSWORD_HASH=scrypt$<salt-base64url>$<digest-base64url>
# AUTH_SESSION_TTL_SECONDS=604800

# Development defaults to deterministic mode when omitted. Set these explicitly
# only when testing an authorized Bailian Qwen account with synthetic data.
GENERATION_MODE=deterministic
# BAILIAN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# BAILIAN_MODEL_ID=qwen-plus
# BAILIAN_STRUCTURED_OUTPUT=json_schema
# BAILIAN_TEMPERATURE=0.1
# BAILIAN_API_KEY=replace-with-worker-only-secret
# Required only when configuring a Workspace API Key through the workbench.
# Generate with: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
# API and Generation Worker must share the same value; never expose it to Web.
# MODEL_CREDENTIAL_ENCRYPTION_KEY=replace-with-32-byte-base64-key
