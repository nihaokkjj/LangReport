{
  "name": "@langreport/api",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "tsx src/server.ts",
    "provision:production": "tsx src/provision-production.ts",
    "test": "tsx --test --test-concurrency=1 test/unit/auth.test.ts test/unit/http-contracts.test.ts test/unit/http-errors.test.ts test/unit/data-assets.test.ts test/unit/openapi.test.ts",
    "test:coverage": "tsx --test --experimental-test-coverage --test-concurrency=1 test/unit/auth.test.ts test/unit/http-contracts.test.ts test/unit/http-errors.test.ts test/unit/data-assets.test.ts test/unit/openapi.test.ts",
    "test:typecheck": "tsc --noEmit -p tsconfig.test.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "build": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@fastify/cors": "11.3.0",
    "@fastify/multipart": "10.1.1",
    "@langreport/contracts": "workspace:*",
    "@langreport/chart": "workspace:*",
    "@langreport/data-engine": "workspace:*",
    "@langreport/generation": "workspace:*",
    "@langreport/memory": "workspace:*",
    "@langreport/model-gateway": "workspace:*",
    "@langreport/plugins": "workspace:*",
    "@langreport/db": "workspace:*",
    "@langreport/storage": "workspace:*",
    "dotenv": "17.4.2",
    "drizzle-orm": "0.45.2",
    "fastify": "5.12.1",
    "postgres": "3.4.9"
  },
  "devDependencies": {
    "@types/node": "26.4.0",
    "tsx": "4.23.13",
    "typescript": "7.0.2"
  }
}
